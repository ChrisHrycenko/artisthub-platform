# ArtistHub .gitignore

# ------------------------------------------------------------------ #
# Secrets — NEVER commit these                                         #
# ------------------------------------------------------------------ #
.env

# ------------------------------------------------------------------ #
# Python                                                               #
# ------------------------------------------------------------------ #
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# ------------------------------------------------------------------ #
# Flask / SQLAlchemy                                                   #
# ------------------------------------------------------------------ #
# SQLite database file — generated at runtime, not source code
backend/instance/
*.db

# Flask-Migrate generated files (keep migrations/ folder itself)
# migrations/versions/*.py  <- DO commit these

# ------------------------------------------------------------------ #
# Testing / coverage                                                   #
# ------------------------------------------------------------------ #
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ------------------------------------------------------------------ #
# IDEs and editors                                                     #
# ------------------------------------------------------------------ #
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ------------------------------------------------------------------ #
# Docker                                                               #
# ------------------------------------------------------------------ #
docker/data/
