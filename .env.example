# Environment variables for ArtistHub backend
#
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to git — it is in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   cd backend && python run.py

# ------------------------------------------------------------------ #
# Flask core                                                           #
# ------------------------------------------------------------------ #

# REQUIRED in production. Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Flask environment: development | testing | production
# Controls which Config class is loaded in create_app().
FLASK_ENV=development

# ------------------------------------------------------------------ #
# Database                                                             #
# ------------------------------------------------------------------ #

# SQLite (default — file created at backend/instance/artisthub.db):
# DATABASE_URL=sqlite:///artisthub.db

# ------------------------------------------------------------------ #
# PostgreSQL — Phase 8A (docker-compose.postgres.yml override)        #
# ------------------------------------------------------------------ #
# Use these three variables when running the PostgreSQL Compose stack.
# They are interpolated into docker-compose.postgres.yml at runtime.
#
# POSTGRES_DB       — database name inside the postgres container
# POSTGRES_USER     — database superuser / application user
# POSTGRES_PASSWORD — REQUIRED; never commit a real value to git
#
# POSTGRES_DB=artisthub
# POSTGRES_USER=artisthub
# POSTGRES_PASSWORD=change-this-to-a-strong-password

# Full DATABASE_URL for the Flask application.
# When using the PostgreSQL Compose override, this must match the three
# variables above. The docker-compose.postgres.yml file constructs this
# automatically from the component parts; set it here only when running
# Flask outside Docker (e.g. `flask db upgrade` on the host).
#
# Local development (matches postgres container service name):
# DATABASE_URL=postgresql+psycopg2://artisthub:change-this-to-a-strong-password@localhost:5432/artisthub
#
# Production / OpenShift (replace placeholders):
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>?sslmode=require
# Existing implicit postgresql:// URLs are normalized to psycopg2 by the app.

# ------------------------------------------------------------------ #
# CORS                                                                 #
# ------------------------------------------------------------------ #

# Comma-separated list of allowed frontend origins.
# In production, replace with your actual frontend URL.
# CORS_ORIGINS=https://artisthub.example.com

# ------------------------------------------------------------------ #
# Kafka / Outbox Relay (Phase 7C)                                      #
# ------------------------------------------------------------------ #

# Comma-separated Kafka broker addresses.
# Local Redpanda (Phase 7A): localhost:9092
# Confluent Cloud (Phase 8D): pkc-XXXXX.us-east-1.aws.confluent.cloud:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security protocol: PLAINTEXT (local Redpanda) or SASL_SSL (Confluent Cloud)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SASL mechanism — only used when KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISMS=PLAIN

# Schema Registry URL — Confluent wire format for Avro serialization (Phase 7F)
# Local development (Redpanda embedded schema registry):
SCHEMA_REGISTRY_URL=http://localhost:8081
# Confluent Cloud (Phase 8D):
# SCHEMA_REGISTRY_URL=https://psrc-XXXXX.us-east-1.aws.confluent.cloud

# ------------------------------------------------------------------ #
# Confluent Cloud credentials (Phase 8D)                               #
# ------------------------------------------------------------------ #
#
# NEVER commit real values. These are read from environment variables
# only. See scripts/confluent-provision.md for provisioning steps.
#
# Kafka cluster API credentials (outbox-relay + consumers):
# CONFLUENT_API_KEY=
# CONFLUENT_API_SECRET=
#
# Schema Registry credentials (avro_utils.py HTTP basic auth):
# SCHEMA_REGISTRY_API_KEY=
# SCHEMA_REGISTRY_API_SECRET=

# Absolute path to the kafka/schemas/ directory containing .avsc files.
# Leave unset for local development — avro_utils.py resolves the path
# from its own location (backend/app/services/avro_utils.py → 3 parents
# → repo root). Set this in Docker/production where the schema files are
# copied to a fixed location (/app/kafka/schemas) and path traversal
# from the module file would resolve incorrectly.
# Docker: set automatically in docker/Dockerfile via ENV KAFKA_SCHEMAS_DIR=/app/kafka/schemas
# KAFKA_SCHEMAS_DIR=/app/kafka/schemas

# Outbox relay tuning (optional — these are the defaults)
# OUTBOX_POLL_INTERVAL=5
# OUTBOX_BATCH_SIZE=100

# ------------------------------------------------------------------ #
# Analytics Consumer (Phase 7D)                                        #
# ------------------------------------------------------------------ #

# Consumer group ID — change only if you need to reset offsets
# KAFKA_CONSUMER_GROUP=artisthub.analytics.v1

# Max DB retries before an event is dead-lettered (default: 3)
# ANALYTICS_MAX_RETRIES=3

# Base retry sleep in seconds — doubles on each attempt (default: 1.0)
# ANALYTICS_RETRY_BACKOFF=1.0

# ------------------------------------------------------------------ #
# Notification Consumer (Phase 7E)                                     #
# ------------------------------------------------------------------ #

# Consumer group ID — change only if you need to reset offsets
# NOTIF_CONSUMER_GROUP=artisthub.notifications.v1

# Max DB retries before an event is dead-lettered (default: 3)
# NOTIF_MAX_RETRIES=3

# Base retry sleep in seconds — doubles on each attempt (default: 1.0)
# NOTIF_RETRY_BACKOFF=1.0

# ------------------------------------------------------------------ #
# ArtistHub AI — Phase 9A (watsonx.ai)                                #
# ------------------------------------------------------------------ #
#
# WATSONX_API_KEY and WATSONX_PROJECT_ID are SECRETS — never commit.
# The remaining variables are safe (non-secret config).
#
# IBM Cloud IAM API key for watsonx.ai authentication.
# Generate at: cloud.ibm.com → Manage → Access → API keys
# WATSONX_API_KEY=
#
# watsonx.ai project ID (or space ID if using a deployment space).
# WATSONX_PROJECT_ID=
#
# watsonx.ai API base URL (default: us-south IBM Cloud endpoint).
# WATSONX_API_URL=https://us-south.ml.cloud.ibm.com
#
# Foundation model ID used for generation.
# WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
#
# Maximum new tokens per response (default: 512).
# WATSONX_MAX_TOKENS=512
#
# Sampling temperature — 0.1 gives near-deterministic answers.
# WATSONX_TEMPERATURE=0.1
#
# HTTP timeout in seconds for watsonx.ai requests (default: 30).
# WATSONX_TIMEOUT=30
#
# Maximum retry attempts on transient errors (default: 2).
# WATSONX_MAX_RETRIES=2
#
# Set to "true" to run ArtistHub AI without IBM credentials.
# Returns a canned stub response — safe for local dev / CI.
# MUST be "false" (or unset) in production.
WATSONX_MOCK=true
