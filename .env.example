# Environment variables for ArtistHub backend
#
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to git — it is in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   cd backend && python run.py

# ------------------------------------------------------------------ #
# Flask core                                                           #
# ------------------------------------------------------------------ #

# REQUIRED in production. Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Flask environment: development | testing | production
# Controls which Config class is loaded in create_app().
FLASK_ENV=development

# ------------------------------------------------------------------ #
# Database                                                             #
# ------------------------------------------------------------------ #

# SQLite (default — file created at backend/instance/artisthub.db):
# DATABASE_URL=sqlite:///artisthub.db

# PostgreSQL (production example):
# DATABASE_URL=postgresql://user:password@localhost:5432/artisthub

# ------------------------------------------------------------------ #
# CORS                                                                 #
# ------------------------------------------------------------------ #

# Comma-separated list of allowed frontend origins.
# In production, replace with your actual frontend URL.
# CORS_ORIGINS=https://artisthub.example.com

# ------------------------------------------------------------------ #
# Kafka / Outbox Relay (Phase 7C)                                      #
# ------------------------------------------------------------------ #

# Comma-separated Kafka broker addresses.
# Local Redpanda (Phase 7A): localhost:9092
# Confluent Cloud: pkc-xxxxx.region.provider.confluent.cloud:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security protocol: PLAINTEXT (local) or SASL_SSL (Confluent Cloud)
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Confluent Cloud credentials — leave blank for local development.
# CONFLUENT_API_KEY=
# CONFLUENT_API_SECRET=

# Outbox relay tuning (optional — these are the defaults)
# OUTBOX_POLL_INTERVAL=5
# OUTBOX_BATCH_SIZE=100
