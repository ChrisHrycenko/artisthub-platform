{
  "type": "record",
  "namespace": "io.artisthub.events",
  "name": "ArtistMerchDeleted",
  "doc": "Emitted when an artist deletes a merchandise product listing. Source: DELETE /api/merch/<id> (merch.py after db.session.commit). Topic: artisthub.catalog. Message key: artist_id.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID v4 uniquely identifying this event instance."
    },
    {
      "name": "event_type",
      "type": "string",
      "doc": "Always 'artist.merch.deleted'.",
      "default": "artist.merch.deleted"
    },
    {
      "name": "event_version",
      "type": "string",
      "doc": "Schema version. Current: '1'.",
      "default": "1"
    },
    {
      "name": "occurred_at",
      "type": "string",
      "doc": "ISO 8601 UTC datetime of the delete action."
    },
    {
      "name": "producer",
      "type": "string",
      "doc": "Originating service.",
      "default": "artisthub-api"
    },
    {
      "name": "correlation_id",
      "type": ["null", "string"],
      "doc": "Optional Flask request trace ID.",
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "ArtistMerchDeletedPayload",
        "doc": "Business data for the artist.merch.deleted event.",
        "fields": [
          {
            "name": "product_id",
            "type": "int",
            "doc": "Primary key of the deleted MerchProduct row."
          },
          {
            "name": "artist_id",
            "type": "int",
            "doc": "Artist who owned the product. Also used as the Kafka message key."
          },
          {
            "name": "deleted_at",
            "type": "string",
            "doc": "ISO 8601 UTC datetime of the delete action (event occurred_at)."
          }
        ]
      }
    }
  ]
}
