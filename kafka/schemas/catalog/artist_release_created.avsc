{
  "type": "record",
  "namespace": "io.artisthub.events",
  "name": "ArtistReleaseCreated",
  "doc": "Emitted when an artist creates a music release. Source: POST /api/releases (releases.py after db.session.commit). Topic: artisthub.catalog. Message key: artist_id.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID v4 uniquely identifying this event instance."
    },
    {
      "name": "event_type",
      "type": "string",
      "doc": "Always 'artist.release.created'.",
      "default": "artist.release.created"
    },
    {
      "name": "event_version",
      "type": "string",
      "doc": "Schema version. Current: '1'.",
      "default": "1"
    },
    {
      "name": "occurred_at",
      "type": "string",
      "doc": "ISO 8601 UTC datetime when the release was created."
    },
    {
      "name": "producer",
      "type": "string",
      "doc": "Originating service.",
      "default": "artisthub-api"
    },
    {
      "name": "correlation_id",
      "type": ["null", "string"],
      "doc": "Optional Flask request trace ID.",
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "ArtistReleaseCreatedPayload",
        "doc": "Business data for the artist.release.created event.",
        "fields": [
          {
            "name": "release_id",
            "type": "int",
            "doc": "Primary key of the new MusicRelease row. Source: release.to_dict()['id']."
          },
          {
            "name": "artist_id",
            "type": "int",
            "doc": "Artist who created the release. Source: release.to_dict()['artist_id']. Also used as the Kafka message key."
          },
          {
            "name": "title",
            "type": "string",
            "doc": "Release title (1–200 chars). Source: release.to_dict()['title']."
          },
          {
            "name": "release_type",
            "type": "string",
            "doc": "One of: Single, EP, Album, Mixtape, Compilation, Live. Source: release.to_dict()['release_type']."
          },
          {
            "name": "genre",
            "type": ["null", "string"],
            "doc": "Optional genre tag. Source: release.to_dict()['genre'].",
            "default": null
          },
          {
            "name": "description",
            "type": ["null", "string"],
            "doc": "Optional release description. Source: release.to_dict()['description'].",
            "default": null
          },
          {
            "name": "artwork_url",
            "type": ["null", "string"],
            "doc": "Optional external artwork image URL. Source: release.to_dict()['artwork_url'].",
            "default": null
          },
          {
            "name": "streaming_url",
            "type": ["null", "string"],
            "doc": "Optional external streaming link (Spotify, SoundCloud, etc.). Source: release.to_dict()['streaming_url'].",
            "default": null
          },
          {
            "name": "release_date",
            "type": ["null", "string"],
            "doc": "Optional ISO 8601 date (YYYY-MM-DD). Source: release.to_dict()['release_date'].",
            "default": null
          },
          {
            "name": "created_at",
            "type": "string",
            "doc": "ISO 8601 UTC datetime when the row was inserted. Source: release.to_dict()['created_at']."
          }
        ]
      }
    }
  ]
}
