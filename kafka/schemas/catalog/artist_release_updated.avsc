{
  "type": "record",
  "namespace": "io.artisthub.events",
  "name": "ArtistReleaseUpdated",
  "doc": "Emitted when an artist updates an existing music release. Source: PUT /api/releases/<id> (releases.py after db.session.commit). Topic: artisthub.catalog. Message key: artist_id.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID v4 uniquely identifying this event instance."
    },
    {
      "name": "event_type",
      "type": "string",
      "doc": "Always 'artist.release.updated'.",
      "default": "artist.release.updated"
    },
    {
      "name": "event_version",
      "type": "string",
      "doc": "Schema version. Current: '1'.",
      "default": "1"
    },
    {
      "name": "occurred_at",
      "type": "string",
      "doc": "ISO 8601 UTC datetime when the update occurred."
    },
    {
      "name": "producer",
      "type": "string",
      "doc": "Originating service.",
      "default": "artisthub-api"
    },
    {
      "name": "correlation_id",
      "type": ["null", "string"],
      "doc": "Optional Flask request trace ID.",
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "ArtistReleaseUpdatedPayload",
        "doc": "Business data for the artist.release.updated event. Contains the full post-update state of the release (not a delta).",
        "fields": [
          {
            "name": "release_id",
            "type": "int",
            "doc": "Primary key of the updated MusicRelease row."
          },
          {
            "name": "artist_id",
            "type": "int",
            "doc": "Artist who owns the release. Also used as the Kafka message key."
          },
          {
            "name": "title",
            "type": "string",
            "doc": "Release title after update."
          },
          {
            "name": "release_type",
            "type": "string",
            "doc": "Release type after update."
          },
          {
            "name": "genre",
            "type": ["null", "string"],
            "doc": "Genre after update.",
            "default": null
          },
          {
            "name": "description",
            "type": ["null", "string"],
            "doc": "Description after update.",
            "default": null
          },
          {
            "name": "artwork_url",
            "type": ["null", "string"],
            "doc": "Artwork URL after update.",
            "default": null
          },
          {
            "name": "streaming_url",
            "type": ["null", "string"],
            "doc": "Streaming URL after update.",
            "default": null
          },
          {
            "name": "release_date",
            "type": ["null", "string"],
            "doc": "Release date (YYYY-MM-DD) after update.",
            "default": null
          }
        ]
      }
    }
  ]
}
