{
  "type": "record",
  "namespace": "io.artisthub.events",
  "name": "ArtistRegistered",
  "doc": "Emitted when a new artist account is created. Source: POST /api/auth/artist/register (auth.py after db.session.commit). Topic: artisthub.identity. Message key: artist_id. NOTE: email is included here because the identity topic drives onboarding workflows — it must NEVER appear in artisthub.social or artisthub.catalog events.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID v4 uniquely identifying this event instance."
    },
    {
      "name": "event_type",
      "type": "string",
      "doc": "Always 'artist.registered'.",
      "default": "artist.registered"
    },
    {
      "name": "event_version",
      "type": "string",
      "doc": "Schema version. Current: '1'.",
      "default": "1"
    },
    {
      "name": "occurred_at",
      "type": "string",
      "doc": "ISO 8601 UTC datetime when the artist account was created."
    },
    {
      "name": "producer",
      "type": "string",
      "doc": "Originating service.",
      "default": "artisthub-api"
    },
    {
      "name": "correlation_id",
      "type": ["null", "string"],
      "doc": "Optional Flask request trace ID.",
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "ArtistRegisteredPayload",
        "doc": "Business data for the artist.registered event. This payload contains email — consumers on artisthub.identity may process PII; ensure appropriate access controls on this topic.",
        "fields": [
          {
            "name": "artist_id",
            "type": "int",
            "doc": "Primary key of the new Artist row. Source: artist.to_dict()['id']. Also used as the Kafka message key."
          },
          {
            "name": "email",
            "type": "string",
            "doc": "Artist's email address. PII — present on this topic only to enable onboarding workflows. Source: artist.to_dict()['email']."
          },
          {
            "name": "display_name",
            "type": "string",
            "doc": "Artist's display name. Source: artist.to_dict()['display_name']."
          },
          {
            "name": "genre",
            "type": ["null", "string"],
            "doc": "Artist's genre at registration time. May be null if not provided. Source: artist.to_dict()['genre'].",
            "default": null
          },
          {
            "name": "location",
            "type": ["null", "string"],
            "doc": "Artist's location at registration time. May be null if not provided. Source: artist.to_dict()['location'].",
            "default": null
          },
          {
            "name": "registered_at",
            "type": "string",
            "doc": "ISO 8601 UTC datetime when the artist row was created. Source: artist.to_dict()['created_at']."
          }
        ]
      }
    }
  ]
}
